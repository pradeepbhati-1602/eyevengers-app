{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eyevengers-app.onrender.com/api/:path*"
    },
    {
      "source": "/invoices/:path*",
      "destination": "https://eyevengers-app.onrender.com/invoices/:path*"
    },
    {
      "source": "/prescriptions/:path*",
      "destination": "https://eyevengers-app.onrender.com/prescriptions/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
